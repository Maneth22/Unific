# --- Database ---
DATABASE_URL=postgresql+asyncpg://unific:unific_dev_password@localhost:55432/unific_platform

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-generate-a-real-64-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Secrets encryption (Account Registry credential envelope) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# --- CORS ---
CORS_ORIGINS=http://localhost:5183

# --- Frontend origin (used to build links returned to a dashboard, e.g.
# a community's registration invite URL) — must match the frontend dev
# port above (frontend/vite.config.js), not Vite's generic 5173 default.
FRONTEND_BASE_URL=http://localhost:5183

# --- This backend's own public origin (used to compute the expected
# WhatsApp webhook URL for the Diagnostics panel's status check) ---
BACKEND_BASE_URL=http://localhost:8000

# --- WhatsApp agent deep link (wa.me) shown after public member registration ---
WHATSAPP_AGENT_DISPLAY_NUMBER=

# --- Login protection ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Providers ---
# WhatsApp stays mock until Cloud API credentials exist.
WHATSAPP_PROVIDER=mock
# Reply drafting + translation use Gemini once GEMINI_API_KEY is set below;
# fall back to TRANSLATION_PROVIDER=mock / REPLY_PROVIDER=stub with no key.
TRANSLATION_PROVIDER=gemini
REPLY_PROVIDER=gemini
# The Meeting Room's intermediary agent (clarify inbound, tone analysis,
# outbound translation in character voice, session/satisfaction reports).
# "gemini" or "mock".
COMMS_AGENT_PROVIDER=gemini

# WhatsApp Cloud API (only used when WHATSAPP_PROVIDER=cloud_api)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
# Set to any secret string of your choosing, then enter that same string
# in the Meta App Dashboard's webhook config — Meta echoes it back on the
# GET verification handshake and this backend checks it matches.
WHATSAPP_CLOUD_API_VERIFY_TOKEN=
# Graph API version segment used to build every WhatsApp Cloud API URL —
# bump this when Meta deprecates the current version.
WHATSAPP_API_VERSION=v20.0
# App-level credentials (Meta App Dashboard > Settings > Basic) — only
# needed for the WhatsApp Diagnostics panel's webhook-status check.
WHATSAPP_CLOUD_API_APP_ID=
WHATSAPP_CLOUD_API_APP_SECRET=

# --- Gemini (used when TRANSLATION_PROVIDER=gemini / REPLY_PROVIDER=gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_RATE_LIMIT_DELAY=0.2
GEMINI_MAX_CONCURRENT=4

# --- LiveKit (video conferencing) ---
# Get credentials at https://cloud.livekit.io — these are LiveKit's own
# standard env var names (their SDKs read them by default). Falls back to
# VIDEO_PROVIDER=mock (no real room/token) with no credentials set.
VIDEO_PROVIDER=livekit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEETING_INVITE_TTL_HOURS=6
MEETING_TOKEN_TTL_MINUTES=180

# --- Live captions / dubbed audio / translated chat (LiveKit Agents) ---
# Embedded in this same process — see app/meeting_room/live_agents/. Gemini
# (auth reuses GEMINI_API_KEY above) is used only for translation; STT/TTS
# are separate, pluggable-per-language providers configured below.
LIVE_AGENTS_BOT_IDENTITY=unific-agent
LIVE_AGENTS_DEFAULT_LANGUAGE=en
# gemini-2.5-flash 404s on generateContent for many keys now (deprecated —
# "no longer available to new users"); verify any model change here with a
# live generate_content call before relying on it, not just client.models.list().
LIVE_AGENTS_GEMINI_MODEL=gemini-3.6-flash
# Master off-switch for captions + dubbed audio (chat translation is
# unaffected either way — it only needs Gemini). Leave false until
# DEEPGRAM_API_KEY / AZURE_SPEECH_KEY+REGION / GOOGLE_APPLICATION_
# CREDENTIALS are actually configured — constructing those STT/TTS
# clients without credentials can hang the whole server (see
# live_agents/orchestrator.py's comment on this setting).
LIVE_AGENTS_CAPTIONS_ENABLED=false
# "specialized_first" | "generic_first" — which TranslatorManager prompt
# strategy in-call CHAT translation tries first (captions always use
# "generic_first"). "specialized_first" is the Singlish/Hinglish-aware
# multi-target prompt; set to "generic_first" to revert to the original
# single-pair-prompt-first behavior without a code change.
LIVE_AGENTS_CHAT_TRANSLATION_MODE=specialized_first

# {language_code: stt_provider_name} — single source of truth for which
# languages are selectable at all. Sinhala ("si") is deliberately NOT on
# "deepgram" — Deepgram's supported-language set doesn't include it.
LIVE_AGENTS_STT_PROVIDER_MAP={"en": "deepgram", "hi": "deepgram", "si": "google"}
# {language_code: {"provider": ..., "voice": ...}} — a language with STT
# but no TTS entry here still fully supports captions_only, just not
# audio_mode=dubbed_audio.
LIVE_AGENTS_TTS_PROVIDER_MAP={"hi": {"provider": "azure", "voice": "hi-IN-SwaraNeural"}, "si": {"provider": "azure", "voice": "si-LK-SameeraNeural"}}

# --- Deepgram (STT: en, hi per the map above) ---
DEEPGRAM_API_KEY=436fcf6ee861f558bd2245aefa618577680f1537

# --- Azure Speech (STT fallback for si; TTS for hi, si) — same two vars
# back both the STT and TTS Azure plugins ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Google Cloud Speech (STT: si, via Chirp 3) ---
# A GCP service-account JSON file path, read directly by the Google Cloud
# SDK from this env var — NOT the same credential as GEMINI_API_KEY above.
# Gemini's Developer API key and a GCP service account are two unrelated
# products/billing relationships; don't conflate them.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Three independent concurrency caps, tuned for a 1vCPU/2GB droplet —
# adjust per host. See app/config.py's comments for what each bounds.
LIVE_AGENTS_MAX_CONCURRENT_STT_SESSIONS=8
LIVE_AGENTS_MAX_CONCURRENT_TTS_PIPELINES=6
LIVE_AGENTS_MAX_CONCURRENT_TRANSLATE_CALLS=8
LIVE_AGENTS_DUB_QUEUE_MAXSIZE=4

# --- Environment ---
ENVIRONMENT=development
