# Read by `docker compose` for ${VAR} substitution inside docker-compose.yml
# itself (separate from backend/.env, which is the app's own runtime
# config, loaded into the containers via env_file). Copy this to
# `platform/.env` and fill it in — docker compose auto-loads a `.env` file
# from the same directory as docker-compose.yml.

# Redis auth (defense-in-depth alongside not publishing 6379 to the host —
# see docker-compose.yml's redis service comment). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=change-me-generate-a-real-secret
